@page "/events"

<PageTitle>Events | EventEase</PageTitle>

<h1>Upcoming Events</h1>

<p>Explore our upcoming events and select one to learn more.</p>

<div class="event-grid">

    @foreach (var item in events)
    {
        <EventCard @key="item.Id" Event="item" />
    }

</div>

